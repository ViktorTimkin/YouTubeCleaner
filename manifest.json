{
  "manifest_version": 3,
  "name": "YouTube Cleaner",
  "version": "1.0.0",
  "description": "Управление комментариями, лайками и историей YouTube.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "YouTube Cleaner",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*",
        "https://myactivity.google.com/*"
      ],
      "js": ["content.js"]
    }
  ]
}